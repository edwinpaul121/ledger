# Points at the "db" service in docker-compose.yml.
# If you're running Next.js outside Docker but Postgres inside it, use
# DATABASE_URL="postgresql://ledger:ledger@localhost:5432/ledger" instead.
DATABASE_URL="postgresql://ledger:ledger@db:5432/ledger"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional - the app runs fine without these, you just won't see the
# Google/GitHub buttons until they're set. See README for how to get them.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Free key from https://www.themoviedb.org/settings/api - needed to run
# `npm run fetch:movies`
TMDB_API_KEY=""

# For games (IGDB via Twitch). Register a Twitch Developer app at
# https://dev.twitch.tv/console/apps to get these - needed to run
# `npm run fetch:games`
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# For books (Open Library data dump). No key needed - just a contact email for the
# User-Agent so they can reach you if needed. Used by `npm run fetch:books`
OPENLIBRARY_CONTACT="you@example.com"

# ---- Catalog automation -------------------------------------------------
# On first start the app fills any empty catalog (movies, shows, games, books)
# with quality titles from these start years up to the present (capped at
# today), then checks once every 24h for new releases. Needs the API keys above.
IMPORT_FROM_YEAR_MOVIES=1888
IMPORT_FROM_YEAR_SHOWS=1888
IMPORT_FROM_YEAR_GAMES=1950
IMPORT_FROM_YEAR_BOOKS=1800
# IMPORT_TO_YEAR=2026   # optional; defaults to the current year

# Page budgets - each applies PER DECADE (20 movies/shows per page, 50 games per page).
TMDB_PAGES=15
TMDB_SHOW_PAGES=8
IGDB_PAGES=6

# Speed: parallel requests to TMDB (movies 10, shows 4 shows at once) and how many
# days a title counts as fresh. Titles already imported within that window are
# skipped, so re-running the import resumes instead of starting over.
TMDB_CONCURRENCY=10
TMDB_REFRESH_DAYS=30

# Quality filters (ignored for the daily new-release check):
TMDB_MIN_VOTES=100        # movies need at least this many votes + a poster
TMDB_SHOW_MIN_VOTES=50    # shows likewise
IGDB_MIN_RATINGS=5        # games need a cover + this many ratings

# Books come from Open Library's monthly data dump (~3.5 GB streamed, nothing big
# saved to disk): the most-shelved works with a cover, up to this many.
OL_MAX_BOOKS=5000
OL_MIN_READS=10           # a work needs at least this many readers shelving it

# Daily check: how far back to look, hours between checks, pages per check.
SYNC_WINDOW_DAYS=30
SYNC_INTERVAL_HOURS=24
SYNC_MAX_PAGES=3
# Set to false to turn the automatic backfill + daily check off entirely.
AUTO_CATALOG=true
# Save a catalog snapshot (db-seed/catalog.json.gz) after each fetch, and restore it
# automatically when the catalog is empty. Set to false to disable saving.
AUTO_SNAPSHOT=true
